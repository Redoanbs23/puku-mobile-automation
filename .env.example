# Copy to .env and fill in only what you need to override.
# Never commit real values — see R3 in test-design-epic-auth-login.md and
# docs/adr/ADR-004-tf-workflow-gap.md. .env is already gitignored;
# .env.example is intentionally tracked.

# Path to the PUKU APK under test (defaults to ../apk/puku.apk if unset)
PUKU_APK_PATH=

# Emulator/device targeting (defaults: Pixel_7 / Android 14)
DEVICE_NAME=
PLATFORM_VERSION=

# ---------------------------------------------------------------------------
# puku-cli ConPTY automation (CLI-E2E-001)
# ---------------------------------------------------------------------------
# Path to the installed puku-cli launcher (the .cmd on Windows, the shim
# script on macOS/Linux). Required by tests/specs/cli/* — the spec skips
# itself if unset. The path is intentionally NOT hardcoded so the same
# code runs on any contributor machine + CI without leaking a personal
# file layout.
PUKU_CLI_PATH=

