# Copy to .env and fill in only what you need to override.
# Never commit real values — see R3 in test-design-epic-auth-login.md and
# docs/adr/ADR-004-tf-workflow-gap.md. .env is already gitignored;
# .env.example is intentionally tracked.

# Path to the PUKU APK under test (defaults to ../apk/puku.apk if unset)
PUKU_APK_PATH=

# Emulator/device targeting (defaults: Pixel_7 / Android 14)
DEVICE_NAME=
PLATFORM_VERSION=
