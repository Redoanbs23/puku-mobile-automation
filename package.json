{
  "name": "puku-mobile-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Black-box mobile test automation framework for PUKU Editor (Android) — WebdriverIO + Appium/UiAutomator2.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:p0": "wdio run wdio.conf.ts --mochaOpts.grep=@p0",
    "test:p1": "wdio run wdio.conf.ts --mochaOpts.grep=@p1",
    "test:cli": "tsx ./node_modules/mocha/bin/mocha.js ./tests/cli/puku-cli-session.spec.ts",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "appium": "^2.0.0",
    "appium-uiautomator2-driver": "^4.1.2",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "allure-commandline": "^2.0.0",
    "dotenv": "^16.0.0",
    "typescript": "^5.5.0",
    "tsx": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "allowScripts": {
    "appium@2.19.0": true,
    "sharp@0.34.2": true,
    "edgedriver@6.3.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "geckodriver@6.1.1": true
  }
}
